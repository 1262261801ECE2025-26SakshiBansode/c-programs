#include <stdio.h>

struct Student
{
    int rollno;
    char name[50];
    float sub1, sub2, sub3;
    float total, percentage;
};

int main()
{
    struct Student s[100];
    int n, i;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("\nEnter details of student %d:\n", i + 1);

        printf("Roll No: ");
        scanf("%d", &s[i].rollno);

        printf("Name: ");
        scanf("%s", s[i].name);

        printf("Subject 1: ");
        scanf("%f", &s[i].sub1);

        printf("Subject 2: ");
        scanf("%f", &s[i].sub2);

        printf("Subject 3: ");
        scanf("%f", &s[i].sub3);

        s[i].total = s[i].sub1 + s[i].sub2 + s[i].sub3;

        s[i].percentage = s[i].total / 3;
    }

    printf("\nRollNo\tName\tSub1\tSub2\tSub3\tTotal\tPercentage\n");

    for(i = 0; i < n; i++)
    {
        printf("%d\t%s\t%.2f\t%.2f\t%.2f\t%.2f\t%.2f%%\n",
        s[i].rollno, s[i].name,
        s[i].sub1, s[i].sub2, s[i].sub3,
        s[i].total, s[i].percentage);
    }

    return 0;
}
